# Godot 4.x project ignores (task P0.1)

# Godot's local editor cache, regenerated per machine
.godot/

# Legacy import cache (pre-4.x layout; harmless to exclude under 4.7)
.import/

# export_presets.cfg IS committed: it carries no secrets today and P4.5.3
# requires byte-identical repeat exports, which needs the preset under version
# control. If signing is ever added, keep the keystore path and password in
# environment variables, never in this file.

# Compiled translation binaries, generated from source .csv/.po files
*.translation

# Build output: the release exports P0.2 produces are not committed
builds/
export/
*.pck
*.exe
*.exp
*.lib
*.pdb

# E0.1/E0.2 connection-test scaffolding: throwaway, never enters the repository
sandbox/

# Locally built, commit-pinned MCP servers (E0.1/P0.5). Tooling, not project
# source: node_modules and compiled output, rebuilt from the pinned commits
# recorded in docs/28. Never committed.
#
# Narrowed from `tools/` to `tools/mcp/` in Phase 02 (LEDGER F02-05). The broad
# rule matched this comment's intent but not its wording: it also swallowed
# `tools/checks/`, where the P1.1 banned-API check lives, so a required build
# check could never be committed - and it swallowed `tools/.gdignore`, the file
# that keeps the servers out of an exported build, which docs/28 then had to
# describe as something recreated by hand after every rebuild. Both are now
# committed. `sandbox/` stays fully ignored, so `sandbox/.gdignore` is still a
# manual step.
tools/mcp/

# Local permission overrides. .claude/settings.json IS versioned, but its
# *.local.* sibling carries machine-specific permission grants and must never be
# published. Do not rely on a machine-global ignore file for this: that file does
# not travel with a clone, and this repository now has a remote.
.claude/settings.local.json

# gdUnit4 HTML/XML test reports, regenerated by every headless run (P0.7).
# Excluded from exports as well, via export_presets.cfg's exclude_filter.
reports/
