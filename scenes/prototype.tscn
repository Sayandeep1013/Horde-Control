; Art pass (D102): looped battle-theme background music on the Music bus
; (default_bus_layout.tres). See src/audio/music_player.gd's header for
; why looping is set on the AudioStream resource's own import params
; rather than in code, and for how it fades out on run end without
; touching src/run/run_flow_controller.gd.
[node name="Music" type="Node" parent="."]
script = ExtResource("24_musicplayer")
stream = ExtResource("25_musicstream")

; Integration task (F05-15). The Level-Up Draft: "nothing opens a Draft in
; the running game today" per P2.12's own evidence report. A CanvasLayer,
; sibling of Main, matching Hud's/ThreatFeedbackLayer's own placement
; convention -- pickup_system_path/upgrade_system_path/wave_director_path/
; ui_sfx_path all resolve through Main/... since this node sits one level
; above it. run_seed is deliberately NOT authored here -- see
; PrototypeIntegration.run_seed and _wire_run_seed() (F05-13): the
; composition root sets it at runtime from the one true source so this
; export and WaveDirector.run_seed cannot silently drift apart.
[node name="DraftInstance" parent="." instance=ExtResource("21_draft")]
pickup_system_path = NodePath("../Main/PickupSystem")
upgrade_system_path = NodePath("../Main/UpgradeSystem")
wave_director_path = NodePath("../Main/WaveDirector")
ui_sfx_path = NodePath("../UiSfx")

; Integration task (F05-27). RunFlowController: owns the run's
; RUNNING/PAUSED/ENDED state and which of the pause/settings/run-end
; screens is on top; builds its own three CanvasLayers in _ready() (no
; wrapper scene needed -- see src/run/run_flow_controller.gd's own
; _build_ui()). Its own tower_path/wave_director_path exports have NO
; default (unlike PrototypeIntegration's Main/... defaults), so both are
; set explicitly here; set_run_inventory() is a required
; code call -- see PrototypeIntegration._wire_run_flow_controller(). D115
; (no in-run shop) removed the Console; set_console_ref() no longer exists.
[node name="RunFlowController" type="Node" parent="."]
script = ExtResource("23_runflow")
tower_path = NodePath("../Main/Tower")
wave_director_path = NodePath("../Main/WaveDirector")

; The debug overlay (P1.4), toggled by F1 (docs/19 > Input Map; Author
; decision D78). Present here because the feel check at P2.7 is the point
; of this scene, and the overlay carries exactly what a feel verdict needs
; to be more than an impression: FPS current/median/1st-percentile, entity
; counts, both health pools, and SimClock. It was built in Phase 02 and
; bound to F1, but was not in this scene, so F1 did nothing.
[node name="DebugOverlay" parent="." instance=ExtResource("17_overlay")]

; The Wave Director (P2.8), brought forward after the author's P2.7 feel
; verdict named its absence directly. Runs the Register's prototype
; sequence: T1-T4 teaching waves, then combat waves 1-4, with enemies
; arriving from the Tower and view spawn rings on schedule rather than
; sitting in the arena from the first frame.
;
; Placed under Main, not beside it, so it inherits the gameplay root's
; PROCESS_MODE_PAUSABLE and stops when the game pauses -- a wave clock that
; kept running through a pause would spawn a wave into a paused arena.
;
; The three enemy scenes are supplied here rather than hardcoded in the
; director, per the data-over-code rule, and the camera is supplied so the
; ring's camera-exclusion check tests against the real view rather than a
; guess (Register > Spawning & Waves > "Camera exclusion").
[node name="WaveDirector" type="Node" parent="Main"]
script = ExtResource("18_director")
entity_spawner_path = NodePath("../EntitySpawner")
tower_path = NodePath("../Tower")
camera_path = NodePath("../Player/GameCamera")
; Integration task (F04-04): the real DebugOverlay instance below, so
; Pressure, its escalation state and the health quadrant actually reach
; the overlay instead of only being reachable through the
; get_..._for_test() getters. Resolved lazily by WaveDirector's own
; _resolve_debug_overlay() -- no code call needed on top of this path.
debug_overlay_path = NodePath("../../DebugOverlay")
tower_seeker_scene = ExtResource("7_seeker")
player_hunter_scene = ExtResource("8_hunter")
opportunist_scene = ExtResource("9_opportunist")

; Integration task (F04-11/F04-12, F05-07). PickupSystem: the pool of
; XP/Scrap drops, magnet attraction, collection and the run's Scrap/XP/
; level state (run_inventory). entity_spawner_path/player_path/
; player_collector_path are the three seams P2.10's own evidence report
; named as unwired; PrototypeIntegration._wire_pickup_system() (code, not
; a NodePath) connects each enemy's removed_while_stuck signal, since a
; signal connection cannot be expressed as an @export NodePath.
[node name="PickupSystem" type="Node2D" parent="Main"]
script = ExtResource("19_pickupsystem")
entity_spawner_path = NodePath("../EntitySpawner")
player_path = NodePath("../Player")
player_collector_path = NodePath("../Player/Collector")

; Integration task (F05-06/F05-07). UpgradeSystem: owns every upgrade
; rank and pushes recomputed multipliers into the four live components
; below, plus the Tower's evolution-stage counter (tower_evolution_stage_
; path, this pass's own addition -- F05-06, "nothing sums evolution_stage_
; contribution and pushes it to TowerEvolutionStage").
[node name="UpgradeSystem" type="Node" parent="Main"]
script = ExtResource("20_upgradesystem")
player_weapon_path = NodePath("../Player/AutoWeapon")
player_path = NodePath("../Player")
tower_weapon_path = NodePath("../Tower/TowerWeapon")
tower_health_path = NodePath("../Tower/TowerHealth")
tower_evolution_stage_path = NodePath("../Tower/TowerEvolutionStage")

