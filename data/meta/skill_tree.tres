[gd_resource type="Resource" script_class="SkillTreeDefinition" format=3]

[ext_resource type="Script" path="res://src/data/skill_tree_definition.gd" id="1_tree"]
[ext_resource type="Script" path="res://src/data/skill_node_definition.gd" id="2_node"]

; Permanent Skill Tree (Meta layer core). docs/18_Permanent_Skill_Tree.md
; section 4 (tree shape, node table, prices) is the authoritative design
; this file authors as data; MASTER_SDLC.md > Provisional Values Register >
; "Meta: Skill Tree effects" for every effect/value/rank count, > "Meta:
; Skill Tree costs" for the tier base prices (read live from
; SkillNodeDefinition.price_for_rank(), never restated as a literal here).
;
; Layout (docs/18 4.1/4.2): three branches of 6 nodes each (Archer/Tower/
; Fortune) fan out from the root ("Command Tent", id "root", tier 0, always
; owned, free) -- Archer west (negative x), Tower east (positive x),
; Fortune south (positive y). Each branch: two tier-1 siblings adjacent to
; the root -> each continues to its own tier-2 node -> BOTH tier-2 nodes
; are required (docs/18: "each name BOTH of their tier-2 siblings") to
; unlock a single converging tier-3 node -> which unlocks the tier-4
; capstone (Second Wind / Fortress / War Chest). `prerequisite_ids` is the
; REAL unlock graph (docs/18 4.1); `grid_position` is cosmetic only, for the
; Hub/Skill Tree screen's own canvas layout.

[sub_resource type="Resource" id="Resource_root"]
script = ExtResource("2_node")
id = "root"
display_name = "Command Tent"
description_template = "The heart of the War Camp. Always yours."
branch = 0
grid_position = Vector2i(0, 0)
tier = 0
max_rank = 1
effect_kind = 0
value_per_rank = 0.0
prerequisite_ids = Array[String]([])

; --- Archer branch (west) ----------------------------------------------------

