nodes = Array[SkillNodeDefinition]([SubResource("Resource_root"), SubResource("Resource_vitality"), SubResource("Resource_swift_boots"), SubResource("Resource_sharpened_arrows"), SubResource("Resource_quick_draw"), SubResource("Resource_long_reach"), SubResource("Resource_second_wind"), SubResource("Resource_stone_walls"), SubResource("Resource_arrow_slits"), SubResource("Resource_shield_runes"), SubResource("Resource_masons_kit"), SubResource("Resource_watchtower"), SubResource("Resource_fortress"), SubResource("Resource_scavenger"), SubResource("Resource_scholar"), SubResource("Resource_lucky_draw"), SubResource("Resource_prospector"), SubResource("Resource_deep_pockets"), SubResource("Resource_war_chest")])
