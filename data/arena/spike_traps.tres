[gd_resource type="Resource" script_class="ArenaSpikeLayout" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/arena/arena_spike_layout.gd" id="1_layout"]

; Eight plates at the chokepoints (Register "v1.0 Arena Layout", docs/33 B5, D335): one on the deck of each
; bridge and one on the Tower-side road 140 px from the bridge centre. Order: north deck, east deck,
; south deck, west deck, then the four road plates (north, east, south, west). Phase offsets stagger the
; cycles so a bridge's two plates never raise together. tests/unit/arena_interactables_test.gd checks
; each plate against ArenaLayout.
[resource]
script = ExtResource("1_layout")
positions = PackedVector2Array(-384, -576, 896, -128, 384, 576, -896, 128, -384, -436, 756, -128, 384, 436, -756, 128)
phase_offsets = PackedFloat32Array(0.0, 0.8, 1.6, 2.4, 1.1, 1.9, 2.7, 0.3)
