[resource]
script = ExtResource("1_enc")
unique_id = "combat_1_hunt"
encounter_type = 3
design_intent = "Threaten the player specifically and pull them away from the Tower."
; pressure_target: NO REGISTER ROW -- escalated. See t1_standard_assault.tres.
pressure_target = 0.0
player_answer = "Kite in wide arcs, use the Tower as a damage assist, and avoid getting cornered."
failure_signature = "The player runs in a straight line, gets surrounded at a map boundary, and dies with the Tower at full health."
spawn_groups = Array[SpawnGroup]([SubResource("Resource_group_1"), SubResource("Resource_group_2"), SubResource("Resource_group_3"), SubResource("Resource_group_4")])
intent_budget_overrides = Array[IntentBudgetOverride]([])
directional_weighting_override = null
telegraph_requirements = Array[TelegraphData]([])
minimum_recovery_gap_seconds = 8.0
priority = 40
entity_cap_behavior = 0
encounter_alive_cap = 0
allowed_encounter_tags = Array[String]([])
excluded_encounter_tags = Array[String]([])
reward = null
failure_resolution = 0
partial_reward_rules = null
