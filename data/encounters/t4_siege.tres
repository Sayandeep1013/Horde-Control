[gd_resource type="Resource" script_class="EncounterDefinition" format=3]

[ext_resource type="Script" path="res://src/data/encounter_definition.gd" id="1_enc"]
[ext_resource type="Script" path="res://src/data/spawn_group.gd" id="2_group"]

; MASTER_SDLC.md > Encounter Types > "Siege". Spawn groups: Register >
; Encounter Budgets > "T4 Siege, teaching (max 40 s)": "Seekers 12 @3 s
; interval 2.0 s (starting estimate; tuned in P2.14); Hunters 2 @10 s
; interval 0.5 s; exempt from the volume formula" (docs/11's fuller
; statement carries the Hunters group's own 0.5 s interval; the Register's
; own abbreviated transcription of the same row omits it). T4 is exempt
; from the Siege volume formula (Register), so these are the authored
; numbers directly, not a computed result.

[sub_resource type="Resource" id="Resource_group_1"]
script = ExtResource("2_group")
enemy_definition_id = "tower_seeker"
count = 12
start_offset_seconds = 3.0
spawn_interval_seconds = 2.0

[sub_resource type="Resource" id="Resource_group_2"]
script = ExtResource("2_group")
enemy_definition_id = "player_hunter"
count = 2
start_offset_seconds = 10.0
spawn_interval_seconds = 0.5

[resource]
script = ExtResource("1_enc")
unique_id = "t4_siege"
encounter_type = 2
design_intent = "Threaten the Tower specifically and pull the player home."
; pressure_target: NO REGISTER ROW -- escalated. See t1_standard_assault.tres.
pressure_target = 0.0
player_answer = "Abandon the map periphery, commit to close defence, and accept the loss of resource income for the duration."
failure_signature = "The player keeps farming the map edges and returns to a critically damaged Tower."
spawn_groups = Array[SpawnGroup]([SubResource("Resource_group_1"), SubResource("Resource_group_2")])
intent_budget_overrides = Array[IntentBudgetOverride]([])
directional_weighting_override = null
telegraph_requirements = Array[TelegraphData]([])
minimum_recovery_gap_seconds = 10.0
priority = 80
entity_cap_behavior = 0
encounter_alive_cap = 0
allowed_encounter_tags = Array[String]([])
excluded_encounter_tags = Array[String]([])
reward = null
failure_resolution = 0
partial_reward_rules = null
pause_and_deferral_behavior = 0
