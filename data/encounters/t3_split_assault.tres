[gd_resource type="Resource" script_class="EncounterDefinition" format=3]

[ext_resource type="Script" path="res://src/data/encounter_definition.gd" id="1_enc"]
[ext_resource type="Script" path="res://src/data/spawn_group.gd" id="2_group"]

; MASTER_SDLC.md > Encounter Types > "Split Assault". Spawn groups:
; Register > Encounter Budgets > "T3 Split, light (max 30 s)": "Seekers
; 8 @0 s interval 1.25 s (5 heavy / 3 light); Opportunists 4 @10 s interval
; 1.0 s (3 heavy / 1 light)." The heavy/light split is COMPUTED at runtime
; by src/director/spawn_geometry.gd's split_assault_lane_sequence()
; (ceil(0.6*n) to the heavier lane, alternating by spawn index -- C-GROUPS),
; not authored as separate groups; the parenthetical counts above are
; transcribed here only as the source text's own cross-check (ceil(0.6*8)=5,
; ceil(0.6*4)=3, both match).

[sub_resource type="Resource" id="Resource_group_1"]
script = ExtResource("2_group")
enemy_definition_id = "tower_seeker"
count = 8
start_offset_seconds = 0.0
spawn_interval_seconds = 1.25

[sub_resource type="Resource" id="Resource_group_2"]
script = ExtResource("2_group")
enemy_definition_id = "opportunist"
count = 4
start_offset_seconds = 10.0
spawn_interval_seconds = 1.0

[resource]
script = ExtResource("1_enc")
unique_id = "t3_split_assault"
encounter_type = 1
design_intent = "Force the player to choose a side of the battlefield."
; pressure_target: NO REGISTER ROW -- escalated. See t1_standard_assault.tres.
pressure_target = 0.0
player_answer = "Pick the heavier lane, accept damage on the lighter one, and rely on Tower weapons to hold what the player abandons."
failure_signature = "The player oscillates between lanes, arrives late to both, and loses Tower health to both."
spawn_groups = Array[SpawnGroup]([SubResource("Resource_group_1"), SubResource("Resource_group_2")])
intent_budget_overrides = Array[IntentBudgetOverride]([])
directional_weighting_override = null
telegraph_requirements = Array[TelegraphData]([])
minimum_recovery_gap_seconds = 8.0
priority = 60
entity_cap_behavior = 0
encounter_alive_cap = 0
allowed_encounter_tags = Array[String]([])
excluded_encounter_tags = Array[String]([])
reward = null
failure_resolution = 0
partial_reward_rules = null
