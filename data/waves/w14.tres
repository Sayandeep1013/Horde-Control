; PT-SWARM wave 14, grand assault (docs/33 C1-C3). Multipliers, durations and gaps are
; Register "v1.0 Enemies, Bosses & Waves" > "Wave sequence". Fodder HP is low and
; counts are high: threat comes from numbers and the speed ramp (D343).

[sub_resource type="Resource" id="Resource_finisher_rate"]
script = ExtResource("3_rate")
count = 2
interval_seconds = 5.0

[sub_resource type="Resource" id="Resource_finisher_drop"]
